# Variables de entorno requeridas para BigNetiK Telecom Backend
# Copia este archivo como .env y rellena los valores

# OBLIGATORIO: Clave secreta para firmar los tokens JWT
# Genera una con: node -e "require('crypto').randomBytes(48).toString('hex').then(console.log)"
# o: openssl rand -hex 48
JWT_SECRET=cambia_esto_por_una_clave_secreta_aleatoria_de_al_menos_32_caracteres

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Configuración de correo SMTP (opcional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=usuario@example.com
# SMTP_PASS=contraseña
# SMTP_FROM=noreply@example.com
